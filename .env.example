# Copier ce fichier en .env et remplir. Le .env n'est JAMAIS commité.
# Les mêmes valeurs devront être créées en "secrets" sur GitHub pour le cron.

# console.anthropic.com  (attention : ce n'est PAS ton abonnement Claude, c'est une facturation séparée)
ANTHROPIC_API_KEY=

# platform.openai.com
OPENAI_API_KEY=

# perplexity.ai  > Settings > API
PERPLEXITY_API_KEY=

# dataforseo.com  (identifiants de type login + mot de passe, pas une clé)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
